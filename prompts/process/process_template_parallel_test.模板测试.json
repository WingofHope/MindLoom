{
    "id": "process_template_parallel_test",
    "name": "模板测试",
    "description": "用于并行模板测试。",
    "inputs": [
        {
            "name": "input",
            "description": "输入测试。",
            "type": "string"
        }
    ],
    "outputs":[
        {
            "name": "GNSS_address",
            "description": "地址",
            "type": "string"
        },
        {
            "name": "local_time",
            "description": "输出本地时间。",
            "type": "string"
        }
    ],
    "execution":{
        "type": "parallel",
        "max_parallel_num":10,
        "parallels": [
            {
                "description": "获取当前位置描述",
                "priority":1,
                "call":{
                    "class": "tool",
                    "id": "local.local_address",
                    "inputs": [],
                    "outputs": [
                        {
                            "name": "local_address",
                            "type": "string",
                            "target": "GNSS_address"
                        }
                    ]
                }
            },
            {
                "description": "获取当前的时间信息",
                "priority":2,
                "call":{
                    "class": "tool",
                    "id": "local.local_time",
                    "inputs": [
                        {
                            "name": "timezone",
                            "type": "string",
                            "value": "Asia/Shanghai"
                        }],
                    "outputs": [
                        {
                            "name": "local_time",
                            "type": "string",
                            "target": "local_time"
                        }
                    ]
                }
            }
        ]
    }
}